# MongoDB
MONGO_URI=

# Telegram (get from @BotFather; leave empty to disable adapter)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot is allowed to stay in, e.g. -1001234567890,-1009876543210
# When set, the bot instantly leaves any other group someone adds it to.
# Leave empty for open mode (any group accepted).
TELEGRAM_ALLOWED_CHAT_IDS=

# Slack (Socket Mode app; leave empty to disable adapter)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Microsoft Teams (Azure Bot registration; leave empty to disable adapter)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=
TEAMS_PORT=3978
